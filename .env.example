INFRA_HTTP_PROTOCOL=http
# Base domain. Subdomains: admin.<base> (admin), auth.<base> (Zitadel), tenants at
# <slug>.<base>. For local dev you can drop the app. prefix and use localhost directly.
INFRA_HTTP_BASE_DOMAIN=app.localhost
INFRA_HTTP_OIDC_SUBDOMAIN=auth
INFRA_ADMIN_SUBDOMAIN=admin
INFRA_API_ROUTE=api
INFRA_DOCS_ROUTE=docs
INFRA_NETWORK_NAME=infra

INFRA_PG_USER=postgres
INFRA_PG_PASSWORD=postgres
INFRA_PG_ZITADEL_DB=zitadel
INFRA_PG_CORE_DB=service_core

# Zitadel master key — MUST be exactly 32 characters. Generate, don't reuse this.
INFRA_ZITADEL_MASTERKEY=changeme_32_characters_long_xxxx
INFRA_ZITADEL_ADMIN_USERNAME=admin
# Must satisfy Zitadel's default password complexity: upper + lower + digit + symbol, len >= 8.
INFRA_ZITADEL_ADMIN_PASSWORD=ChangeMe1!
# Default (master) organization. Seeded on startup.
INFRA_DEFAULT_ORG_NAME=My Organization
# Host the default org is served on. Blank = the base domain (master on the apex).
# Set to its own domain (e.g. product.com) when it should differ from the platform
# base domain — needs its own Traefik route + TLS. Tenant orgs stay <slug>.<base>.
INFRA_DEFAULT_ORG_DOMAIN=
# Set the owner email to provision a human owner (org_owner + admin) for the default
# org — this is what turns a fresh deploy into a usable single-org install. Leave the
# email blank for a SaaS-style deploy where orgs (and their owners) are added later.
INFRA_DEFAULT_ORG_OWNER_EMAIL=
# Owner's initial password (must meet Zitadel complexity: upper+lower+digit+symbol, >=8).
INFRA_DEFAULT_ORG_OWNER_PASSWORD=
# Optional display name; defaults to the email local-part.
INFRA_DEFAULT_ORG_OWNER_NAME=

# SMTP (optional, instance-level) — groundwork, not yet applied by the bootstrap.
# Needed later for email verification, password reset, and SaaS owner invites. With
# no SMTP configured, email verification is off and the owner uses the password above.
# INFRA_SMTP_HOST=
# INFRA_SMTP_PORT=587
# INFRA_SMTP_USER=
# INFRA_SMTP_PASSWORD=
# INFRA_SMTP_FROM=
# INFRA_SMTP_FROM_NAME=
# INFRA_SMTP_TLS=true

INFRA_REGISTRATOR_RELOAD_DELAY=5s
INFRA_REGISTRATOR_POLL_INTERVAL=30s
INFRA_REGISTRATOR_IMAGE=registrator:latest
# Forked Login UI v2 (built from ./zitadel-login). Set to
# ghcr.io/zitadel/zitadel-login:v4.15.2 to run the stock upstream login instead.
INFRA_ZITADEL_LOGIN_IMAGE=zitadel-login:latest
