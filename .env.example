INFRA_HTTP_PROTOCOL=http
INFRA_HTTP_BASE_DOMAIN=app.localhost
INFRA_HTTP_OIDC_SUBDOMAIN=auth
INFRA_API_ROUTE=api
INFRA_DOCS_ROUTE=docs
INFRA_NETWORK_NAME=infra

INFRA_PG_USER=postgres
INFRA_PG_PASSWORD=postgres
INFRA_PG_ZITADEL_DB=zitadel

# Zitadel master key — MUST be exactly 32 characters. Generate, don't reuse this.
INFRA_ZITADEL_MASTERKEY=changeme_32_characters_long_xxxx
INFRA_ZITADEL_ADMIN_USERNAME=admin
# Must satisfy Zitadel's default password complexity: upper + lower + digit + symbol, len >= 8.
INFRA_ZITADEL_ADMIN_PASSWORD=ChangeMe1!
# Default organization (the non-SaaS case): seeded on the base domain.
INFRA_DEFAULT_ORG_NAME=My Organization

INFRA_REGISTRATOR_RELOAD_DELAY=5s
INFRA_REGISTRATOR_POLL_INTERVAL=30s
INFRA_REGISTRATOR_IMAGE=registrator:latest
# Forked Login UI v2 (built from ./zitadel-login). Set to
# ghcr.io/zitadel/zitadel-login:v4.15.2 to run the stock upstream login instead.
INFRA_ZITADEL_LOGIN_IMAGE=zitadel-login:latest
