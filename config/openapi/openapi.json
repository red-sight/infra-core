{
  "components": {
    "schemas": {
      "CreateInputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/CreateInputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "description": {
            "description": "Organization description (optional)",
            "maxLength": 500,
            "type": "string"
          },
          "name": {
            "description": "Organization name",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "slug": {
            "description": "DNS-safe subdomain label (e.g. acme)",
            "pattern": "^[a-z0-9-]{2,40}$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "slug"
        ],
        "type": "object"
      },
      "CreateItemDto": {
        "properties": {
          "description": {
            "example": "A useful widget",
            "type": "string"
          },
          "name": {
            "example": "Widget",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/ErrorModel.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "nullable": true,
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Item": {
        "properties": {
          "description": {
            "example": "A useful widget",
            "type": "string"
          },
          "id": {
            "example": 1,
            "type": "number"
          },
          "name": {
            "example": "Widget",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "ListMembersOutputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/ListMembersOutputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Member"
            },
            "nullable": true,
            "type": "array"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "type": "object"
      },
      "ListOutputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/ListOutputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrgResponse"
            },
            "nullable": true,
            "type": "array"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "type": "object"
      },
      "Member": {
        "additionalProperties": false,
        "properties": {
          "avatar": {
            "description": "Avatar URL (may be empty)",
            "type": "string"
          },
          "email": {
            "description": "Primary email",
            "type": "string"
          },
          "id": {
            "description": "User ID",
            "type": "string"
          },
          "name": {
            "description": "Display name (falls back to username)",
            "type": "string"
          },
          "roles": {
            "description": "Org-scoped roles held in this organization",
            "items": {
              "$ref": "#/components/schemas/MemberRole"
            },
            "nullable": true,
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "avatar",
          "roles"
        ],
        "type": "object"
      },
      "MemberRole": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Role ID",
            "type": "string"
          },
          "name": {
            "description": "Role name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "OrgResponse": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/OrgResponse.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "description": "Organization description",
            "type": "string"
          },
          "domain": {
            "description": "Frontend hostname the organization is served on (slug-derived; apex for the master org)",
            "type": "string"
          },
          "external_id": {
            "description": "Identity-provider organization ID (Logto). Null until synced.",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "description": "Internal organization ID",
            "type": "string"
          },
          "is_master": {
            "description": "True if this is the master organization (apex domain, empty slug)",
            "type": "boolean"
          },
          "name": {
            "description": "Organization name",
            "type": "string"
          },
          "slug": {
            "description": "DNS-safe label addressing the tenant frontend subdomain",
            "type": "string"
          },
          "synced": {
            "description": "Whether the organization has been provisioned in the identity provider.",
            "type": "boolean"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "external_id",
          "synced",
          "slug",
          "name",
          "description",
          "domain",
          "is_master",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "TenantOutputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/TenantOutputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "id": {
            "description": "Internal organization ID",
            "type": "string"
          },
          "is_master": {
            "description": "True if this is the master organization (apex domain)",
            "type": "boolean"
          },
          "name": {
            "description": "Organization name",
            "type": "string"
          },
          "slug": {
            "description": "Tenant slug (empty for the master organization)",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "is_master"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://auth.app.localhost/oidc/auth",
            "scopes": {
              "delete:items": "delete:items",
              "read:organizations": "read:organizations",
              "write:items": "write:items",
              "write:organizations": "write:organizations"
            },
            "tokenUrl": "http://auth.app.localhost/oidc/token"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "title": "Infra API",
    "version": "v1"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/service-a/v1/items": {
      "get": {
        "operationId": "ItemsController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          }
        },
        "security": [],
        "summary": "List all items",
        "tags": [
          "items"
        ]
      },
      "post": {
        "operationId": "ItemsController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateItemDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "BearerAuth": [
              "write:items"
            ]
          }
        ],
        "summary": "Create item",
        "tags": [
          "items"
        ]
      }
    },
    "/api/service-a/v1/items/{id}": {
      "delete": {
        "operationId": "ItemsController_remove",
