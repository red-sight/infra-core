              "type": "number"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": "Not found"
          }
        },
        "security": [
          {
            "BearerAuth": [
              "delete:items"
            ]
          }
        ],
        "summary": "Delete item",
        "tags": [
          "items"
        ]
      },
      "get": {
        "operationId": "ItemsController_findOne",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            },
            "description": ""
          },
          "404": {
            "description": "Not found"
          }
        },
        "security": [],
        "summary": "Get item by ID",
        "tags": [
          "items"
        ]
      }
    },
    "/api/service-core/v1/admin/organizations": {
      "get": {
        "description": "Returns a paginated, searchable list of organizations. Sortable by: name, created_at, updated_at.",
        "operationId": "list-organizations",
        "parameters": [
          {
            "description": "Page number (1-based)",
            "explode": false,
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "description": "Page number (1-based)",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Items per page",
            "explode": false,
            "in": "query",
            "name": "page_size",
            "schema": {
              "default": 20,
              "description": "Items per page",
              "format": "int64",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Column to sort by (allowed: see endpoint description)",
            "explode": false,
            "in": "query",
            "name": "sort_by",
            "schema": {
              "description": "Column to sort by (allowed: see endpoint description)",
              "type": "string"
            }
          },
          {
            "description": "Sort direction",
            "explode": false,
            "in": "query",
            "name": "sort_dir",
            "schema": {
              "default": "desc",
              "description": "Sort direction",
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          },
          {
            "description": "Substring search (case-insensitive, applied across searchable fields)",
            "explode": false,
            "in": "query",
            "name": "q",
            "schema": {
              "description": "Substring search (case-insensitive, applied across searchable fields)",
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "description": "Range start — inclusive, RFC 3339 (e.g. 2024-01-01T00:00:00Z). Omit for open start.",
            "explode": false,
            "in": "query",
            "name": "date_from",
            "schema": {
              "description": "Range start — inclusive, RFC 3339 (e.g. 2024-01-01T00:00:00Z). Omit for open start.",
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Range end — inclusive, RFC 3339 (e.g. 2024-12-31T23:59:59Z). Omit for open end.",
            "explode": false,
            "in": "query",
            "name": "date_to",
            "schema": {
              "description": "Range end — inclusive, RFC 3339 (e.g. 2024-12-31T23:59:59Z). Omit for open end.",
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Filter by name (case-insensitive contains)",
            "explode": false,
            "in": "query",
            "name": "name",
            "schema": {
              "description": "Filter by name (case-insensitive contains)",
              "maxLength": 100,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "BearerAuth": [
              "read:organizations"
            ]
          }
        ],
        "summary": "List organizations",
        "tags": [
          "Admin"
        ]
      },
      "post": {
        "description": "Creates an organization. Core is the source of truth; the organization is provisioned in the identity provider asynchronously, so the response returns synced=false until the outbox worker completes.",
        "operationId": "create-organization",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgResponse"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "BearerAuth": [
              "write:organizations"
            ]
          }
        ],
        "summary": "Create organization",
        "tags": [
          "Admin"
        ]
      }
    },
    "/api/service-core/v1/admin/organizations/{id}": {
      "get": {
        "description": "Returns a single organization by its internal ID.",
        "operationId": "get-organization",
        "parameters": [
          {
            "description": "Internal organization ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Internal organization ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "BearerAuth": [
              "read:organizations"
            ]
          }
        ],
        "summary": "Get organization",
        "tags": [
          "Admin"
        ]
      }
    },
    "/api/service-core/v1/admin/organizations/{id}/members": {
      "get": {
        "description": "Returns the organization's members and their org-scoped roles, sourced from the identity provider. Paginated; q is a case-insensitive match on name/email. An unprovisioned organization has no members yet and returns an empty list.",
        "operationId": "list-organization-members",
        "parameters": [
          {
            "description": "Internal organization ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Internal organization ID",
              "type": "string"
            }
          },
          {
            "description": "Page number (1-based)",
            "explode": false,
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "description": "Page number (1-based)",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Items per page",
            "explode": false,
            "in": "query",
            "name": "page_size",
            "schema": {
              "default": 20,
              "description": "Items per page",
              "format": "int64",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Substring search (case-insensitive, applied across searchable fields)",
            "explode": false,
            "in": "query",
            "name": "q",
            "schema": {
              "description": "Substring search (case-insensitive, applied across searchable fields)",
              "maxLength": 200,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListMembersOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "BearerAuth": [
              "read:organizations"
            ]
          }
        ],
        "summary": "List organization members",
        "tags": [
          "Admin"
        ]
      }
    },
    "/api/service-core/v1/tenant/by-host": {
      "get": {
        "description": "Public endpoint the tenant frontend calls (before login) to resolve its organization from its hostname. The apex domain maps to the master organization; a subdomain maps to the org with that slug.",
        "operationId": "get-tenant-by-host",
        "parameters": [
          {
            "description": "Frontend hostname, e.g. acme.app.localhost or the apex app.localhost",
            "explode": false,
            "in": "query",
            "name": "host",
            "required": true,
            "schema": {
              "description": "Frontend hostname, e.g. acme.app.localhost or the apex app.localhost",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Resolve tenant by host",
        "tags": [
          "Tenant"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "http://app.localhost"
    }
  ],
  "tags": []
}