{
  "components": {
    "schemas": {
      "CreateItemDto": {
        "properties": {
          "description": {
            "example": "A useful widget",
            "type": "string"
          },
          "name": {
            "example": "Widget",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/ErrorModel.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "nullable": true,
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Item": {
        "properties": {
          "description": {
            "example": "A useful widget",
            "type": "string"
          },
          "id": {
            "example": 1,
            "type": "number"
          },
          "name": {
            "example": "Widget",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "ListOutputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/ListOutputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrgResponse"
            },
            "nullable": true,
            "type": "array"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "type": "object"
      },
      "OrgResponse": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "description": "Organization description",
            "type": "string"
          },
          "id": {
            "description": "Internal organization ID",
            "type": "string"
          },
          "logto_org_id": {
            "description": "Logto organization ID",
            "type": "string"
          },
          "name": {
            "description": "Organization name",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "logto_org_id",
          "name",
          "description",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://auth.app.localhost/oidc/auth",
            "scopes": {
              "delete:items": "delete:items",
              "read:organizations": "read:organizations",
              "write:items": "write:items"
            },
            "tokenUrl": "http://auth.app.localhost/oidc/token"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "title": "Infra API",
    "version": "v1"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/service-a/v1/items": {
      "get": {
        "operationId": "ItemsController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          }
        },
        "security": [],
        "summary": "List all items",
        "tags": [
          "items"
        ]
      },
      "post": {
        "operationId": "ItemsController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateItemDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "BearerAuth": [
              "write:items"
            ]
          }
        ],
        "summary": "Create item",
        "tags": [
          "items"
        ]
      }
    },
    "/api/service-a/v1/items/{id}": {
      "delete": {
        "operationId": "ItemsController_remove",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": "Not found"
          }
        },
        "security": [
          {
            "BearerAuth": [
              "delete:items"
            ]
          }
        ],
        "summary": "Delete item",
        "tags": [
          "items"
        ]
      },
      "get": {
        "operationId": "ItemsController_findOne",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            },
            "description": ""
          },
          "404": {
            "description": "Not found"
          }
        },
        "security": [],
        "summary": "Get item by ID",
        "tags": [
          "items"
        ]
      }
    },
    "/api/service-core/v1/admin/organizations": {
      "get": {
        "description": "Returns a paginated, searchable list of organizations. Sortable by: name, created_at, updated_at.",
        "operationId": "list-organizations",
        "parameters": [
          {
            "description": "Page number (1-based)",
            "explode": false,
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "description": "Page number (1-based)",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Items per page",
            "explode": false,
            "in": "query",
            "name": "page_size",
            "schema": {
              "default": 20,
              "description": "Items per page",
              "format": "int64",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Column to sort by (allowed: see endpoint description)",
            "explode": false,
            "in": "query",
            "name": "sort_by",
            "schema": {
              "description": "Column to sort by (allowed: see endpoint description)",
              "type": "string"
            }
          },
          {
            "description": "Sort direction",
            "explode": false,
            "in": "query",
            "name": "sort_dir",
            "schema": {
              "default": "desc",
              "description": "Sort direction",
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          },
          {
            "description": "Substring search (case-insensitive, applied across searchable fields)",
            "explode": false,
            "in": "query",
            "name": "q",
            "schema": {
              "description": "Substring search (case-insensitive, applied across searchable fields)",
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "description": "Range start — inclusive, RFC 3339 (e.g. 2024-01-01T00:00:00Z). Omit for open start.",
            "explode": false,
            "in": "query",
            "name": "date_from",
            "schema": {
              "description": "Range start — inclusive, RFC 3339 (e.g. 2024-01-01T00:00:00Z). Omit for open start.",
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Range end — inclusive, RFC 3339 (e.g. 2024-12-31T23:59:59Z). Omit for open end.",
            "explode": false,
            "in": "query",
            "name": "date_to",
            "schema": {
              "description": "Range end — inclusive, RFC 3339 (e.g. 2024-12-31T23:59:59Z). Omit for open end.",
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Filter by name (case-insensitive contains)",
            "explode": false,
            "in": "query",
            "name": "name",
            "schema": {
              "description": "Filter by name (case-insensitive contains)",
              "maxLength": 100,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "BearerAuth": [
              "read:organizations"
            ]
          }
        ],
        "summary": "List organizations",
        "tags": [
          "Admin"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "http://app.localhost"
    }
  ],
  "tags": []
}