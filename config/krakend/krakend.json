{
  "$schema": "https://www.krakend.io/schema/v2.8/krakend.json",
  "cache_ttl": "300s",
  "endpoints": [
    {
      "backend": [
        {
          "encoding": "json",
          "extra_config": {
            "backend/http": {
              "return_error_code": true,
              "return_error_details": "backend"
            }
          },
          "host": [
            "http://service-core:8080"
          ],
          "method": "GET",
          "url_pattern": "/admin/organizations"
        }
      ],
      "endpoint": "/api/service-core/v1/admin/organizations",
      "extra_config": {
        "auth/validator": {
          "alg": "ES384",
          "audience": [
            "https://api.app.localhost"
          ],
          "disable_jwk_security": true,
          "jwk_url": "http://auth.app.localhost/oidc/jwks",
          "propagate_claims": [
            [
              "sub",
              "x-user-id"
            ],
            [
              "roles",
              "x-user-roles"
            ],
            [
              "organization_id",
              "x-organization-id"
            ]
          ],
          "roles": [
            "admin"
          ],
          "roles_key": "roles",
          "roles_key_is_nested": false
        }
      },
      "input_headers": [
        "Authorization"
      ],
      "method": "GET",
      "output_encoding": "json"
    },
    {
      "backend": [
        {
          "encoding": "json",
          "extra_config": {
            "backend/http": {
              "return_error_code": true,
              "return_error_details": "backend"
            }
          },
          "host": [
            "http://service-a:3000"
          ],
          "is_collection": true,
          "method": "GET",
          "url_pattern": "/items"
        }
      ],
      "endpoint": "/api/service-a/v1/items",
      "method": "GET",
      "output_encoding": "json-collection"
    },
    {
      "backend": [
        {
          "encoding": "json",
          "extra_config": {
            "backend/http": {
              "return_error_code": true,
              "return_error_details": "backend"
            }
          },
          "host": [
            "http://service-a:3000"
          ],
          "method": "POST",
          "url_pattern": "/items"
        }
      ],
      "endpoint": "/api/service-a/v1/items",
      "extra_config": {
        "auth/validator": {
          "alg": "ES384",
          "audience": [
            "https://api.app.localhost"
          ],
          "disable_jwk_security": true,
          "jwk_url": "http://auth.app.localhost/oidc/jwks",
          "propagate_claims": [
            [
              "sub",
              "x-user-id"
            ],
            [
              "roles",
              "x-user-roles"
            ],
            [
              "organization_id",
              "x-organization-id"
            ]
          ],
          "roles": [
            "admin",
            "org_owner",
            "org_user"
          ],
          "roles_key": "roles",
          "roles_key_is_nested": false
        }
      },
      "input_headers": [
        "Authorization",
        "Content-Type"
      ],
      "method": "POST",
      "output_encoding": "json"
    },
    {
      "backend": [
        {
          "encoding": "json",
          "extra_config": {
            "backend/http": {
              "return_error_code": true,
              "return_error_details": "backend"
            }
          },
          "host": [
            "http://service-a:3000"
          ],
          "method": "GET",
          "url_pattern": "/items/{id}"
        }
      ],
      "endpoint": "/api/service-a/v1/items/{id}",
      "method": "GET",
      "output_encoding": "json"
    },
    {
      "backend": [
        {
          "encoding": "json",
          "extra_config": {
            "backend/http": {
              "return_error_code": true,
              "return_error_details": "backend"
            }
          },
          "host": [
            "http://service-a:3000"
          ],
          "method": "DELETE",
          "url_pattern": "/items/{id}"
        }
      ],
      "endpoint": "/api/service-a/v1/items/{id}",
      "extra_config": {
        "auth/validator": {
          "alg": "ES384",
          "audience": [
            "https://api.app.localhost"
          ],
          "disable_jwk_security": true,
          "jwk_url": "http://auth.app.localhost/oidc/jwks",
          "propagate_claims": [
            [
              "sub",
              "x-user-id"
            ],
            [
              "roles",
              "x-user-roles"
            ],
            [
              "organization_id",
              "x-organization-id"
            ]
          ],
          "roles": [
            "admin",
            "org_owner"
          ],
          "roles_key": "roles",
          "roles_key_is_nested": false
        }
      },
      "input_headers": [
        "Authorization"
      ],
      "method": "DELETE",
      "output_encoding": "json"
    }
  ],
  "extra_config": {
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[KRAKEND]",
      "stdout": true,
      "syslog": false
    }
  },
  "name": "Infra API Gateway",
  "output_encoding": "json",
  "timeout": "10000ms",
  "version": 3
}