# OIDC (Zitadel). In Docker these are injected from /run/infra/admin-app.json by the
# entrypoint; set them here only for plain `npm run dev` outside Docker.
VITE_OIDC_ISSUER=http://auth.app.localhost
VITE_OIDC_CLIENT_ID=
VITE_OIDC_PROJECT_ID=
VITE_REDIRECT_URI=http://admin.app.localhost/callback
VITE_API_BASE_URL=http://app.localhost/api
